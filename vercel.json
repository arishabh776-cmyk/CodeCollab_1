{
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/api/rooms/list",
      "destination": "/api/rooms/index"
    },
    {
      "source": "/api/rooms/create",
      "destination": "/api/rooms/index"
    },
    {
      "source": "/api/rooms/:id/join",
      "destination": "/api/rooms/join"
    },
    {
      "source": "/api/rooms/:id/messages",
      "destination": "/api/rooms/messages?id=:id"
    },
    {
      "source": "/api/rooms/send",
      "destination": "/api/rooms/messages"
    },
    {
      "source": "/api/rooms/:id/send",
      "destination": "/api/rooms/messages?id=:id"
    },
    {
      "source": "/api/snippets/save",
      "destination": "/api/snippets/index"
    },
    {
      "source": "/api/snippets/:id",
      "destination": "/api/snippets/index?id=:id"
    },
    {
      "source": "/api/notes/list",
      "destination": "/api/notes/index"
    },
    {
      "source": "/api/notes/:id",
      "destination": "/api/notes/index?id=:id"
    },
    {
      "source": "/api/profile/me",
      "destination": "/api/profile/index"
    },
    {
      "source": "/api/profile/update",
      "destination": "/api/profile/index"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type,X-CC-Token,Authorization"
        }
      ]
    }
  ]
}